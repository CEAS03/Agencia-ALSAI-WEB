{
  "name": "alsai-sitio-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sitio web oficial de Agencia ALSAI — multipágina premium con ecosistema WebGL persistente, sistema de movimiento GSAP y diagnóstico integrado",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:client": "vite build",
    "gen:assets": "node scripts/gen-assets.mjs",
    "preview": "vite preview",
    "test": "node --test src/diagnostic/engine/scoring.test.ts src/diagnostic/engine/soluciones.test.ts",
    "test:crm": "node --experimental-strip-types scripts/test-hubspot-lead.mjs",
    "hubspot:setup": "node scripts/hubspot-setup.mjs",
    "test:n8n": "node --experimental-strip-types n8n/probar-preparar-lead.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "gsap": "^3.12.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
